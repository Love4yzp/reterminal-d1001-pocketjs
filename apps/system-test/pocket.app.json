{
  "$schema": "https://pocketjs.dev/schema/pocket-2.json",
  "pocket": 2,
  "id": "dev.pocket-nexus.d1001.system-test",
  "title": "D1001 System Test",
  "version": "0.1.0",
  "engine": {
    "capabilities": {
      "requires": ["text.glyphs.baked", "data.fs", "system.device", "system.wifi"]
    }
  },
  "app": {
    "entry": "main.tsx",
    "output": "system-test",
    "framework": "solid",
    "tickHz": 30,
    "viewport": {
      "fixed": {
        "logical": [400, 640],
        "presentation": "native"
      }
    }
  }
}
