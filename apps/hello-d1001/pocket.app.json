{
  "$schema": "https://pocketjs.dev/schema/pocket-2.json",
  "pocket": 2,
  "id": "dev.pocket-nexus.d1001.hello",
  "title": "Hello D1001",
  "version": "0.1.0",
  "engine": {
    "capabilities": {
      "requires": ["text.glyphs.baked"]
    }
  },
  "app": {
    "entry": "main.tsx",
    "output": "hello-d1001",
    "framework": "solid",
    "tickHz": 30,
    "viewport": {
      "fixed": {
        "logical": [400, 640],
        "presentation": "native"
      }
    }
  }
}
