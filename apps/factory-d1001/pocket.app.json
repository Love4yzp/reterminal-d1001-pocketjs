{
  "$schema": "https://pocketjs.dev/schema/pocket-2.json",
  "pocket": 2,
  "id": "dev.pocket-nexus.d1001.factory-demo",
  "title": "D1001 Factory Demo",
  "version": "0.1.0",
  "engine": {
    "capabilities": {
      "requires": ["input.touch", "input.buttons", "text.glyphs.baked"]
    }
  },
  "app": {
    "entry": "main.tsx",
    "output": "factory-d1001",
    "framework": "solid",
    "tickHz": 30,
    "viewport": {
      "fixed": {
        "logical": [400, 640],
        "presentation": "native"
      }
    }
  }
}
