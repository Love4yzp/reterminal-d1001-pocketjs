{
  "format": "pocket-host/2",
  "id": "reterminal-d1001",
  "platform": "esp-idf",
  "form": "takeover",
  "cadences": [30],
  "display": {
    "logicalViewports": [[400, 640], [640, 400]],
    "presentations": ["native"],
    "rasterDensity": 2,
    "animation": "repaint"
  },
  "panel": {
    "primary": [800, 1280]
  },
  "capabilities": [
    "data.fs",
    "input.buttons",
    "input.touch",
    "net.http",
    "runtime.worker",
    "system.device",
    "system.wifi",
    "text.glyphs.baked"
  ],
  "worker": {
    "nodes": { "http": 1 }
  },
  "bytecode": {
    "engine": "esp-idf-quickjs-ng-0.14.0",
    "source": "drop"
  }
}
